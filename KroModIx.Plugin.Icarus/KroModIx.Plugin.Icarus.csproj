<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>KroModIx.Plugin.Icarus</RootNamespace>
    <AssemblyName>KroModIx.Plugin.Icarus</AssemblyName>
    <!-- v1.23.0: ohne das landet SharpCompress.dll nicht in bin/ und
         das Release-Bundle stirbt beim ersten Archiv-Install mit
         FileNotFoundException (kroste-avalonia, Plugin-Bundle-Regel). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KroModIx.Plugin.Contracts"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- v1.23.0: ZIP/RAR/7z. Ohne PrivateAssets/ExcludeAssets — SharpCompress
         muss ins Plugin-Bundle, der Host bringt es nicht mit. -->
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.24.0: der Pak-Leser und -Schreiber ist internal (kein Teil der
         Plugin-Oberflaeche), muss aber testbar sein — der Container ist
         genau die Stelle, an der ein Fehler nicht als Ausnahme auffaellt,
         sondern als "die Mod tut nichts". -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KroModIx.Plugin.Icarus.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
