<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>KroModIx.Plugin.Icarus</RootNamespace>
    <AssemblyName>KroModIx.Plugin.Icarus</AssemblyName>
    <!-- Bleibt an, auch ohne eigene NuGet-Abhaengigkeit: kommt eine dazu,
         muss sie ohne weiteren Eingriff im Bundle landen. Ohne das Flag
         stirbt das Release-Bundle beim ersten Aufruf mit
         FileNotFoundException (kroste-avalonia, Plugin-Bundle-Regel). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KroModIx.Plugin.Contracts"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.24.0: der Pak-Leser und -Schreiber ist internal (kein Teil der
         Plugin-Oberflaeche), muss aber testbar sein — der Container ist
         genau die Stelle, an der ein Fehler nicht als Ausnahme auffaellt,
         sondern als "die Mod tut nichts". -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KroModIx.Plugin.Icarus.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
